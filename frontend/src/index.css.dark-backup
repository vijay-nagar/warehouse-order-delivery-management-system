/* ========================================
   PREMIUM DARK NAVY THEME
   Warehouse OMS - Option 5
======================================== */

:root {
  color: #e2e8f0;
  background: #0f172a;
}

body {
  background: #0f172a;
  color: #e2e8f0;
}

/* Main Layout */
.app-main {
  background: #0f172a;
}

/* Header */
.app-header {
  background: #111827;
  border-bottom: 1px solid #1e293b;
  color: #f8fafc;
}

.app-header h1,
.header-left h1 {
  color: #f8fafc;
}

/* Sidebar */
.sidebar {
  background: #0b1120;
  border-right: 1px solid #1e293b;
}

.sidebar-link {
  color: #94a3b8;
}

.sidebar-link:hover {
  background: #1e293b;
  color: #ffffff;
}

.sidebar-link.active {
  background: #2563eb;
  color: #ffffff;
}

/* Module Page */
.module-page-header h1 {
  color: #f8fafc;
}

.module-page-header p {
  color: #94a3b8;
}

/* Refresh Button */
.module-refresh-button {
  background: #1e293b;
  border: 1px solid #334155;
  color: #e2e8f0;
}

.module-refresh-button:hover:not(:disabled) {
  background: #334155;
}

/* Search */
.module-search input {
  background: #111827;
  border: 1px solid #334155;
  color: #f8fafc;
}

.module-search input::placeholder {
  color: #64748b;
}

.module-search input:focus {
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgb(37 99 235 / 20%);
}

/* Record Count */
.module-count {
  color: #94a3b8;
}

/* Table Panel */
.module-panel {
  background: #111827;
  border: 1px solid #1e293b;
  box-shadow: 0 4px 15px rgb(0 0 0 / 20%);
}

/* Table Header */
.module-table th {
  background: #1e293b;
  border-bottom: 1px solid #334155;
  color: #94a3b8;
}

/* Table Cells */
.module-table td {
  background: #111827;
  border-bottom: 1px solid #1e293b;
  color: #cbd5e1;
}

.module-table tbody tr:hover td {
  background: #1e293b;
}

/* Status Badge */
.module-status {
  background: rgb(37 99 235 / 15%);
  color: #60a5fa;
}

/* Empty / Loading State */
.module-state {
  color: #94a3b8;
}

/* Error */
.module-alert-error {
  background: rgb(220 38 38 / 12%);
  border-color: #7f1d1d;
  color: #fca5a5;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: #0f172a;
}

::-webkit-scrollbar-thumb {
  background: #334155;
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: #475569;
}